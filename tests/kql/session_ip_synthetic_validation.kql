  @"L004-OLD", datetime(2026-11-21T12:50:00Z), 4624, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x444", @"203.0.113.77",
  @"P005", datetime(2026-11-21T14:10:00Z), 4688, @"LAB-WIN01", @"LAB\jane", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE", @"0x777", @"", @"",
  @"L005", datetime(2026-11-21T14:08:00Z), 4624, @"LAB-WIN01", @"", @"LAB", @"jane", @"", @"", @"", @"", @"0x777", @"198.51.100.11",
