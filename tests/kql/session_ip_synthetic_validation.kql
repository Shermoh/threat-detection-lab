  @"F006", datetime(2026-11-21T12:32:00Z), 4625, @"LAB-WIN99", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"F007", datetime(2026-11-21T12:20:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"P003", datetime(2026-11-21T13:10:00Z), 4688, @"LAB-WIN04", @"LAB\svc-maint", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Windows\System32\services.exe", @"0x333", @"", @"",
  @"L003", datetime(2026-11-21T13:08:00Z), 4624, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x333", @"192.0.2.20",
  @"F008", datetime(2026-11-21T13:00:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"F009", datetime(2026-11-21T13:03:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"F010", datetime(2026-11-21T13:07:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"P004", datetime(2026-11-21T13:40:00Z), 4688, @"LAB-WIN04", @"LAB\svc-maint", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Windows\System32\services.exe", @"0x444", @"", @"",
  @"L004", datetime(2026-11-21T13:38:00Z), 4624, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x445", @"203.0.113.77",
  @"F011", datetime(2026-11-21T13:31:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"F012", datetime(2026-11-21T13:34:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
