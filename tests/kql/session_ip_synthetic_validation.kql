  @"P007", datetime(2026-11-21T15:10:00Z), 4688, @"LAB-WIN04", @"LAB\svc-maint", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Windows\System32\services.exe", @"0x666", @"", @"",
