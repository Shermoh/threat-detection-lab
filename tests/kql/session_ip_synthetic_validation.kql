// SYNTHETIC KQL VALIDATION HARNESS — no real SecurityEvent ingestion required.
// Paste the ENTIRE file into the Azure Monitor / Sentinel Logs query editor.
// 29 fictional 4624/4625/4688 events in an inline datatable.
// The body copies the source correlation rule with an absolute test clock
// instead of ago() so the results do not change as dates advance.
// Expected: seven PASS rows, zero FAIL rows.
// This file was generated from the repository's CSV fixture, but KQL
// Kusto/Azure Data Explorer synthetic execution verified: 7 PASS, 0 FAIL
// on 2026-11-23 04:04 UTC; live Sentinel telemetry NOT validated.
let testNow=datetime(2026-11-21T16:00:00Z);
let SecurityEvent = datatable(_ItemId:string, TimeGenerated:datetime, EventID:int, Computer:string, Account:string, TargetDomainName:string, TargetUserName:string, NewProcessName:string, CommandLine:string, ParentProcessName:string, SubjectLogonId:string, TargetLogonId:string, IpAddress:string)[
  @"P001", datetime(2026-11-21T12:03:00Z), 4688, @"LAB-WIN04", @"LAB\svc-maint", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Windows\System32\services.exe", @"0x111", @"", @"",
  @"L001", datetime(2026-11-21T12:00:00Z), 4624, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x111", @"192.0.2.10",
  @"F001", datetime(2026-11-21T11:58:00Z), 4625, @"LAB-WIN04", @"", @"LAB", @"svc-maint", @"", @"", @"", @"", @"0x0", @"203.0.113.77",
  @"P002", datetime(2026-11-21T12:40:00Z), 4688, @"LAB-WIN04", @"LAB\svc-maint", @"", @"", @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe", @"powershell.exe -EncodedCommand QQBCAEMA", @"C:\Windows\System32\services.exe", @"0x222", @"", @"",
